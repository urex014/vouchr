# =============================================================
# VOUCHR - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================

# 1. MongoDB Database Connection (Source of Truth)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vouchr?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vouchr

# 2. Authentication Secrets (JWT & Sessions)
AUTH_SECRET=your-super-secure-production-jwt-secret-key-32-chars-minimum

# 3. Reloadly Official Gift Cards API Credentials
RELOADLY_CLIENT_ID=your-reloadly-client-id
RELOADLY_CLIENT_SECRET=your-reloadly-client-secret
RELOADLY_ENVIRONMENT=sandbox

# 4. Payment Provider Keys
PAYMENT_SECRET_KEY=your-payment-secret-key
PAYMENT_PUBLIC_KEY=your-payment-public-key

# 5. Hardcoded Crypto Payout Wallets (Treasury)
CRYPTO_PAYOUT_WALLET_EVM=0x71C83e9613A88126eE7E4eC107297e6e587C6259
CRYPTO_PAYOUT_WALLET_SOL=7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU
CRYPTO_PAYOUT_WALLET_BTC=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# 6. Default Admin Seed Account
ADMIN_EMAIL=admin@vouchr.com
ADMIN_PASSWORD=VouchrAdmin2026!
